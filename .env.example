# ─────────────────────────────────────────────────────────────
# IBO Token Website — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git (it is already in .gitignore).
#
# ⚠  Vite prefixes all browser-exposed vars with VITE_.
#    Every VITE_ variable is bundled into the public JS build
#    and is therefore visible to anyone who views your site.
#    Treat them as PUBLICLY VISIBLE — apply rate limits and
#    allowed-origin restrictions in BscScan / RPC dashboards.
# ─────────────────────────────────────────────────────────────


# ── 6.1  Contract Address ──────────────────────────────────
# The deployed IBO token contract on BNB Smart Chain (0x…).
# Leave blank while the contract is not yet deployed — the
# site will render a "Contract coming soon" placeholder.
VITE_IBO_TOKEN_ADDRESS=


# ── 6.2  BscScan API Key ───────────────────────────────────
# Used for transaction history queries (browser-visible).
# Generate at: https://bscscan.com/myapikey
# Restrict the key: IP allowlist / origin allowlist in BscScan.
VITE_BSCSCAN_API_KEY=


# ── 6.2  BSC RPC URL ───────────────────────────────────────
# Primary RPC endpoint. Public fallbacks are built in so this
# is optional, but providing your own improves reliability.
# Example providers: Ankr, QuickNode, NodeReal, Alchemy.
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org


# ── Burn addresses (optional) ──────────────────────────────
# Wallet that holds the annual burn allocation before it is burned.
VITE_ANNUAL_BURN_ADDRESS=


# ── DEX pair (optional — fill once the pool exists) ────────
VITE_DEX_PAIR_ADDRESS=
VITE_DEX_URL=


# ── External links (optional) ──────────────────────────────
VITE_WHITEPAPER_URL=
VITE_ABT_WORKING_URL=
VITE_TWITTER_URL=
VITE_TELEGRAM_URL=
VITE_SITE_URL=
